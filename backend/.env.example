APP_NAME=WaxPrint ERP
DATABASE_URL=sqlite:///./waxprint_erp.db
FILE_STORAGE_PATH=./data/files
FRONTEND_ORIGIN=http://localhost:5173
AUTO_SEED=true

# Gmail - optional until configured
GMAIL_ENABLED=false
GMAIL_USER=me
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_PUBSUB_TOPIC=
GMAIL_ARCHIVE_LABEL=WAX_ERP_ARCHIVED
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX
GMAIL_FETCH_QUERY=UNSEEN
GMAIL_FETCH_LIMIT=25

# Local agent shared token - change in production
AGENT_TOKEN=change-me
AUTH_SECRET=change-me-auth-secret
